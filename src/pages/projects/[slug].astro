<script>
  import '../../scripts/balanced-gallery';
  import { animate, inView } from 'motion';
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  const film = document.querySelector('.cinema, .film, .archive');
  const animations: ReturnType<typeof animate>[] = [];
  const stop = inView('[data-reveal]', element => {
    if (reduced.matches) return;
    animations.push(animate(element, film ? { opacity: [0.4, 1] } : { opacity: [0.4, 1], transform: ['translateY(16px)', 'translateY(0)'] }, { duration: 0.8, ease: [0.22, 1, 0.36, 1] }));
  });
  reduced.addEventListener('change', () => { if (reduced.matches) { stop(); animations.forEach(animation => animation.complete()); } });
</script>
