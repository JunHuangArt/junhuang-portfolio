---
import projects from '../../data/projects.json';

export function getStaticPaths() {
  return [...projects.map(project => project.slug), 'foldscape'].map(slug => ({ params: { slug } }));
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
return Astro.redirect(`${base}/${Astro.params.slug}/`, 301);
---
