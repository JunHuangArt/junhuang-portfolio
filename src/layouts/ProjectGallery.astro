---
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const localUrl = (path: string) => base + '/' + path.replace(/^\//, '');
const currentYear = new Date().getFullYear();
const activePage = Astro.url.pathname.replace(/\/$/, '').split('/').pop();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#111113" />
    <title>{title} | Jun Huang</title>
    <meta name="description" content={description} />
    <style>
      :global(*) {
        box-sizing: border-box;
      }
      :global([hidden]) { display: none !important; }

      :global(html) {
        color-scheme: dark;
        margin: 0;
        padding: 0;
        scroll-behavior: smooth;
      }

      :global(body) {
        margin: 0;
        padding: 0;

        min-height: 100vh;
        background: #111113;
        color: #eee9e1;

        font-family:
          "Helvetica Neue",
          "Segoe UI",
          Arial,
          sans-serif;
        line-height: 1.6;

        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
      }

      :global(a) {
        color: inherit;
        text-decoration: none;
      }

      :global(img) {
        max-width: 100%;
      }

      :global(::selection) {
        background: #c8ad86;
        color: #111113;
      }


      /* =========================
         HEADER
      ========================= */

      .site-header {
        width: 100%;

        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        align-items: center;
        justify-content: space-between;

        padding: 28px 38px 26px;
        border-bottom: 1px solid rgb(238 233 225 / 9%);
      }

      .brand {
        color: #e3ccb0;
        font-family: "Bodoni MT", Didot, "Times New Roman", serif;
        font-size: 32px;
        font-weight: 400;
        letter-spacing: 0.12em;
        line-height: 1.2;
        white-space: nowrap;
      }

      .brand-group { display: flex; align-items: center; gap: 24px; }
      .brand-tagline { margin: 0; color: #baa78f; font-size: 10px; letter-spacing: 0.16em; }

      .nav {
        display: flex;
        align-items: center;
        gap: 32px;
      }

      .nav-link {
        position: relative;
        color: #b5b0a9;
        transition: color 0.3s ease;

        font-size: 16.5px;
        font-weight: 500;

        letter-spacing: 0.16em;
        line-height: 1.5;
      }

      .nav-link::after {
        content: "";

        position: absolute;

        left: 0;
        bottom: -6px;

        width: 100%;
        height: 1px;

        background: currentColor;

        transform: scaleX(0);
        transform-origin: right center;

        transition:
          transform
          0.3s
          cubic-bezier(0.22, 1, 0.36, 1);
      }

      .nav-link:hover::after, .nav-link:focus-visible::after, .nav-link[aria-current="page"]::after {
        transform: scaleX(1);
        transform-origin: left center;
      }

      .nav-link:hover,
      .nav-link:focus-visible,
      .nav-link[aria-current="page"] {
        color: #e3ccb0;
      }


      .footer {
        margin:
          0
          38px;

        border-top:
          1px solid
          rgb(238 233 225 / 12%);

        padding:
          25px
          0
          35px;

        display: flex;

        align-items: center;
        justify-content: space-between;

        gap: 30px;

        font-size: 11px;

        letter-spacing: 0.12em;

        color: #aaa6a0;
      }
      :global(a:focus-visible) { outline: 2px solid #e3ccb0; outline-offset: 6px; }
      .skip-link { position: absolute; top: 12px; left: 18px; z-index: 10; padding: 12px 16px; background: #111; color: #fff; transform: translateY(-200%); }
      .skip-link:focus { transform: translateY(0); }
      @media (max-width: 900px) { .site-header { padding: 24px; } .footer { margin: 0 24px; } }
      @media (max-width: 650px) {
        .site-header { padding: 20px 18px; gap: 20px; }
        .brand { font-size: 28px; }
        .brand-group { gap: 12px; }
        .brand-tagline { font-size: 9px; letter-spacing: 0.08em; }
        .nav { gap: 17px; }
        .nav-link { font-size: 15px; }
        .footer { margin: 0 18px; flex-direction: column; align-items: flex-start; gap: 8px; }
      }
      @media (max-width: 430px) { .nav { width: 100%; justify-content: space-between; } }
      @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } .nav-link, .nav-link::after { transition: none; } }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#project">Skip to project</a>
    <header class="site-header">

      <div class="brand-group">
      <a
        class="brand"
        href={localUrl("/")}
      >
        JUN HUANG
      </a>
        <p class="brand-tagline">Digital art · Design · Research</p>
      </div>


      <nav class="nav" aria-label="Main navigation">

        <a
          class="nav-link"
          href={localUrl("/")}
          aria-current={activePage !== 'about' && activePage !== 'demoreel' ? 'page' : undefined}
        >
          PROJECTS
        </a>

        <a
          class="nav-link"
          href={localUrl('/demoreel/')}
          aria-current={activePage === 'demoreel' ? 'page' : undefined}
        >
          DEMOREEL
        </a>

        <a
          class="nav-link"
          href={localUrl('/about/')}
          aria-current={activePage === 'about' ? 'page' : undefined}
        >
          ABOUT
        </a>

      </nav>

    </header>
    <slot />
    <footer class="footer">

      <span>
        © {currentYear} JUN HUANG
      </span>

      <span>
        DIGITAL ART · DESIGN · RESEARCH
      </span>

    </footer>
  </body>
</html>
